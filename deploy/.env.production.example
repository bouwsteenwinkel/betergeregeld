# ==========================================================
# Betergeregeld v2 — production .env template
# ==========================================================
# Copy this to the Plesk server, edit with real secrets, place
# in the deployment directory as `.env`. NEVER commit the
# filled-in version — keep secrets in Plesk's File Manager only.
#
# Generate APP_KEY ONCE with: php artisan key:generate --show
# After first deploy: do NOT rotate it (invalidates Vault +
# DirectoryConnection encrypted tokens).
# ==========================================================

APP_NAME="Betergeregeld"
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
APP_DEBUG=false
APP_URL=https://betergeregeld.com
APP_TIMEZONE=Europe/Amsterdam
APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl

# Tell Laravel it's behind the Plesk reverse proxy / SSL terminator
TRUSTED_PROXIES=*
FORCE_HTTPS=true

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ----- Database (MariaDB/MySQL on the same server) -------
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=betergeregeld
DB_USERNAME=betergeregeld
DB_PASSWORD=REPLACE_WITH_PLESK_DB_PASSWORD

# ----- Cache / session / queue ---------------------------
# Keep it simple: file cache + database sessions. No Redis needed.
CACHE_STORE=file
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ----- Mail (Postmark recommended) -----------------------
MAIL_MAILER=postmark
POSTMARK_API_KEY=REPLACE_WITH_POSTMARK_SERVER_TOKEN
MAIL_FROM_ADDRESS="noreply@betergeregeld.com"
MAIL_FROM_NAME="Betergeregeld"

# ----- Mollie (start in TEST mode; flip to live_ later) --
MOLLIE_KEY=test_REPLACE_WITH_MOLLIE_TEST_KEY

# ----- Rebrickable (LEGO tool, safe to leave empty) ------
REBRICKABLE_API_KEY=

# ----- OpenAI (AccessGuard AI). Empty = fake-mode,
#        canned responses, everything else keeps working --
OPENAI_API_KEY=
ACCESSGUARD_AI_ENABLED=true
ACCESSGUARD_AI_MODEL=gpt-4o-mini

# ----- Microsoft Entra ID (leave empty until first
#        customer wants M365 sync; hides the Directory tab) -
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_SCOPE="User.Read.All Directory.Read.All offline_access"
