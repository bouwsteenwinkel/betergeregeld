<?xml version="1.0" encoding="UTF-8"?>
<!--
  ===================================================================
   cookie.betergeregeld.com  ->  301 naar waar de inhoud echt staat
  ===================================================================

  WAAR PLAATSEN
  In de vhost-root van het subdomein op de Windows-server:

      C:\inetpub\vhosts\betergeregeld.com\cookie.betergeregeld.com\

  LET OP: dus GEEN httpdocs eronder. Controleer het pad met:

      Get-Website | Where-Object { $_.Name -like "*cookie*" } |
          Select-Object Name, PhysicalPath

  WAAROM
  Dit subdomein bedient nog de OUDE V1-site. Bewijs: het zet
  Set-Cookie: BSWSESSID (de sessienaam van V1, niet Laravels
  XSRF-TOKEN) en de HTML heeft een robots-meta zonder de
  max-image-preview die V2 altijd meestuurt.

  Gevolg, gemeten 26-08-2026 in Search Console:

    - 9 URL's met een SERVERFOUT (5xx): /{taal}/brickmix/advies,
      /brickmix/bezorging en /brickmix/over-ons in nl, en en es.
      Een 500 is het slechtste signaal dat je kunt geven: Google
      leest het als "server kapot" en blijft het opnieuw proberen.
    - 10 URL's als "Gecrawld, momenteel niet geindexeerd".
    - Daarnaast serveert deze host /privacy, /pakketten, /contact,
      /over-betergeregeld, /algemene-voorwaarden, /disclaimer en
      /binnen-5-min-live: allemaal duplicaten van betergeregeld.com.
      En de canonical daar is RELATIEF, dus die wijst op deze host
      naar zichzelf in plaats van naar het hoofddomein.

  Er staat bovendien een link naar dit subdomein op de homepage van
  V2 (resources/views/welcome.blade.php) onder de productnaam
  "CookieGeregeld". Dat product bestaat hier niet; bezoekers komen op
  een kopie van de oude marketingsite uit. Die link hoort weg of naar
  de juiste pagina te wijzen.

  301 EN NIET DE DNS WEGHALEN: een 301 draagt de opgebouwde waarde
  over. Een verdwenen hostnaam levert Google alleen een fout op en
  die waarde is dan weg.

  ALLEEN GET EN HEAD: een 301 op een POST maakt de browser er een GET
  van en gooit de verzonden gegevens weg.

  NA HET PLAATSEN CONTROLEREN (verwacht overal 301):

      curl -s -o NUL -w "%{http_code} %{redirect_url}\n" ^
        https://cookie.betergeregeld.com/nl/brickmix/advies
      curl -s -o NUL -w "%{http_code} %{redirect_url}\n" ^
        https://cookie.betergeregeld.com/nl/privacy
      curl -s -o NUL -w "%{http_code} %{redirect_url}\n" ^
        https://cookie.betergeregeld.com/
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>

        <!--
          1. De brickmix-pagina's. Die horen thuis op brickmixverhuur.nl,
             de site die er werkelijk over gaat. Padvertaling gemeten op
             26-08-2026:

               /brickmix/bezorging -> /bezorgen-of-ophalen   (200)
               /brickmix/over-ons  -> /over-ons              (200)
               /brickmix/advies    -> geen tegenhanger; /advies geeft 404
                                      daar, dus naar de homepage

             De taalprefix valt weg: brickmixverhuur.nl is alleen NL.
        -->
        <rule name="brickmix bezorging" stopProcessing="true">
          <match url="^(?:nl|en|de|fr|es)/brickmix/bezorging/?$" />
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="^(?:GET|HEAD)$" />
          </conditions>
          <action type="Redirect" url="https://brickmixverhuur.nl/bezorgen-of-ophalen" redirectType="Permanent" appendQueryString="false" />
        </rule>

        <rule name="brickmix over-ons" stopProcessing="true">
          <match url="^(?:nl|en|de|fr|es)/brickmix/over-ons/?$" />
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="^(?:GET|HEAD)$" />
          </conditions>
          <action type="Redirect" url="https://brickmixverhuur.nl/over-ons" redirectType="Permanent" appendQueryString="false" />
        </rule>

        <!-- Alle overige brickmix-paden, inclusief /advies. -->
        <rule name="brickmix overig" stopProcessing="true">
          <match url="^(?:nl|en|de|fr|es)/brickmix(?:/.*)?$" />
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="^(?:GET|HEAD)$" />
          </conditions>
          <action type="Redirect" url="https://brickmixverhuur.nl/" redirectType="Permanent" appendQueryString="false" />
        </rule>

        <!--
          2. Twee pagina's waarvan de naam in V2 anders is. Zonder deze
             twee zou de algemene regel hieronder een 404 opleveren.
        -->
        <rule name="pakketten naar prijzen" stopProcessing="true">
          <match url="^(?:(?:nl|en|de|fr|es)/)?pakketten/?$" />
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="^(?:GET|HEAD)$" />
          </conditions>
          <action type="Redirect" url="https://betergeregeld.com/nl/prijzen" redirectType="Permanent" appendQueryString="false" />
        </rule>

        <rule name="binnen-5-min-live naar home" stopProcessing="true">
          <match url="^(?:(?:nl|en|de|fr|es)/)?binnen-5-min-live/?$" />
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="^(?:GET|HEAD)$" />
          </conditions>
          <action type="Redirect" url="https://betergeregeld.com/nl" redirectType="Permanent" appendQueryString="false" />
        </rule>

        <!--
          3. Alles met een taalprefix gaat een-op-een mee naar V2.
             Gecontroleerd voor privacy, over-betergeregeld,
             algemene-voorwaarden, disclaimer en contact: die worden op
             het hoofddomein zo nodig verder doorgestuurd naar hun
             nieuwe naam.
        -->
        <rule name="met taalprefix naar V2" stopProcessing="true">
          <match url="^((?:nl|en|de|fr|es)/.*)$" />
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="^(?:GET|HEAD)$" />
          </conditions>
          <action type="Redirect" url="https://betergeregeld.com/{R:1}" redirectType="Permanent" appendQueryString="false" />
        </rule>

        <!--
          4. Alles zonder taalprefix krijgt /nl/ ervoor. De oude site had
             geen taal in het pad.
        -->
        <rule name="zonder taalprefix naar V2" stopProcessing="true">
          <match url="^(?!nl/|en/|de/|fr/|es/)(.*)$" />
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="^(?:GET|HEAD)$" />
          </conditions>
          <action type="Redirect" url="https://betergeregeld.com/nl/{R:1}" redirectType="Permanent" appendQueryString="false" />
        </rule>

      </rules>
    </rewrite>
  </system.webServer>
</configuration>
