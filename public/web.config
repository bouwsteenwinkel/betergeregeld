<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!--
                  Kale domeinnaam naar de standaardtaal, in IIS en niet in PHP.

                  routes/web.php heeft hiervoor al een regel die redirect naar
                  config(app.locale). Die werkt, maar start voor een enkele
                  omleiding de hele Laravel-stack op. Gemeten op 24-08-2026:
                  0,96 seconde tot de eerste byte, terwijl een statisch bestand
                  op dezelfde server 0,30 doet. Elke bezoeker die de kale
                  domeinnaam intikt betaalde dat, en daarna pas begon de echte
                  pagina te laden.

                  Meteen 301 in plaats van de 302 die Laravel standaard geeft.
                  /nl draagt een zelfverwijzende canonical en is x-default in de
                  hreflang-set, dus dat IS het adres van de homepage. Bij een 302
                  draagt Google de opgebouwde waarde niet over.

                  Alleen GET en HEAD: een 301 op een POST gooit de gegevens weg.
                  Een POST op de root valt zo nog steeds door naar Laravel, die
                  er netjes 405 op geeft omdat daar alleen een GET-route staat.

                  LET OP: de taal staat hier hard. Verandert app.locale ooit, pas
                  dan deze regel mee aan. De PHP-route blijft als vangnet bestaan,
                  maar dan krijg je twee omleidingen achter elkaar.
                -->
                <rule name="Homepage naar standaardtaal (301, voor PHP)" stopProcessing="true">
                    <match url="^$" />
                    <conditions>
                        <add input="{REQUEST_METHOD}" pattern="^(GET|HEAD)$" />
                    </conditions>
                    <action type="Redirect" url="/nl" redirectType="Permanent" appendQueryString="true" />
                </rule>

                <rule name="Redirect trailing slashes" stopProcessing="true">
                    <match url="^(.*)/$" ignoreCase="false" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
                    </conditions>
                    <action type="Redirect" redirectType="Permanent" url="/{R:1}" />
                </rule>
                <rule name="Front controller" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="/index.php" />
                </rule>
            </rules>
        </rewrite>
        <staticContent>
            <!-- .webmanifest staat niet in de standaard MIME-map van IIS: zonder deze
                 regel geeft de server 404.3 op site.webmanifest. De <remove> ervoor
                 voorkomt een 500 (dubbele entry) als de extensie op serverniveau
                 tóch al geregistreerd is. Zelfde reden voor svg op oudere IIS. -->
            <remove fileExtension=".webmanifest" />
            <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
            <remove fileExtension=".svg" />
            <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
            <!-- Self-hosted fonts: IIS serveert .woff2 anders als 404. -->
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
        </staticContent>
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>
    </system.webServer>
</configuration>
