APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Mollie Payments API — leave empty (or prefix with fake_) to keep billing in
# local dev-mode, which simulates a paid checkout via /billing/fake-confirm.
# Production: use a real test_... or live_... key from your Mollie dashboard.
# For real Mollie testing locally the webhook URL must be publicly reachable
# (use ngrok/cloudflared and set APP_URL accordingly).
MOLLIE_KEY=

# Production uses MariaDB (see DEPLOY.md). Local sqlite works for quick
# tests but several features (JSON columns, upserts) assume MariaDB.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_betergeregeld
DB_USERNAME=betergeregeld
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Afsprakenplanner ──────────────────────────────────────────────────────────
# Zonder deze blok draait de planner in stub-modus: boekingen komen dan in GEEN
# ENKELE agenda en er is geen Meet-link. De site meldt dan gewoon "je afspraak
# staat", dus dit valt niet vanzelf op — zie docs/deploy-bedrijfswebsite.md.
#
# GOOGLE_CALENDAR_ID: laat op 'primary' staan (= de hoofdagenda van het gekoppelde
# account). Alleen invullen bij een bewust gedeelde, niet-primaire agenda.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Het account dat gekoppeld MOET worden; koppelen met een ander account wordt geweigerd.
GOOGLE_CALENDAR_ACCOUNT=info@bouwsteenwinkel.nl
# 'all' = Google nodigt de klant zelf uit en zegt automatisch af bij annuleren.
GOOGLE_CALENDAR_SEND_UPDATES=all

# Waar afspraakmeldingen en agenda-storingen heen gaan (een postbus die iemand leest,
# niet de afzender), en het adres waarop de klant kan antwoorden.
SCHEDULING_NOTIFY_EMAIL=info@bouwsteenwinkel.nl
SCHEDULING_ORGANIZER_EMAIL=info@bouwsteenwinkel.nl
# Herinneringen: x dagen vooraf + een vast klokuur op de dag van de afspraak.
SCHEDULING_REMINDER_LEAD_DAYS=2
SCHEDULING_REMINDER_DAY_OF_HOUR=8

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REBRICKABLE_API_KEY=

# OpenAI (AccessGuard AI-explain, CSV smart-map, screenshot ingest,
# review recommendations, exec summary). Empty or fake_... keeps the
# fake-mode fallback that returns canned responses so the pipeline is
# testable without spending credits.
OPENAI_API_KEY=
ACCESSGUARD_AI_ENABLED=true
ACCESSGUARD_AI_MODEL=gpt-4o-mini

# Microsoft Entra ID (Azure AD) — enables AccessGuard directory sync
# on the Business plan. Create an app registration in Azure Portal,
# grant delegated User.Read.All + Directory.Read.All scopes, and paste
# the client_id + client_secret below. Leave empty to hide the feature.
# Redirect URI on Azure side MUST match MICROSOFT_REDIRECT_URI exactly.
# See DEPLOY.md §13 for the step-by-step.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_SCOPE="User.Read.All Directory.Read.All offline_access"

# AI-kwaliteitscheck (monitoring). De API-key wordt gedeeld met de andere
# Claude-features (blog/vertalingen) via ANTHROPIC_API_KEY. QUALITY_SCAN_MODEL
# is bij voorkeur een klein/goedkoop model. Zet QUALITY_SCAN_AI=false om de
# AI-laag uit te schakelen (alleen deterministische checks draaien dan).
ANTHROPIC_API_KEY=
QUALITY_SCAN_MODEL=claude-haiku-4-5-20251001
QUALITY_SCAN_AI=true
QUALITY_SCAN_ALERT_EMAIL=

# Ops-webhook (POST /webhooks/deploy en /webhooks/artisan). Leeg = endpoints uit (404).
# Zie DEPLOY.md §14.
DEPLOY_TOKEN=
DEPLOY_BRANCH=main
