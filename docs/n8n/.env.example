# =====================================================================
#  n8n deploy — kopieer naar .env en vul in.  NIET committen (zie .gitignore-tip)
# =====================================================================

# Subdomein waarop n8n draait (eerst een A-record naar het VPS-IP zetten)
N8N_HOST=n8n.betergeregeld.com

# Subdomein voor Uptime Kuma (monitoring-dashboard) — ook een A-record naar het VPS-IP
UPTIME_HOST=uptime.betergeregeld.com

# E-mail voor Let's Encrypt (certificaat-meldingen)
ACME_EMAIL=info@betergeregeld.com

# KRITIEK — encryptiesleutel voor opgeslagen credentials.
#   Genereer:  openssl rand -hex 32
#   Bewaar deze OFFLINE veilig. Zonder deze key zijn alle in n8n opgeslagen
#   credentials onbruikbaar na een restore.
N8N_ENCRYPTION_KEY=

# Postgres
POSTGRES_DB=n8n
POSTGRES_USER=n8n
#   Genereer een sterk wachtwoord:  openssl rand -base64 24
POSTGRES_PASSWORD=
